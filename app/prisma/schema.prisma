generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  password            String
  sections            Section[]
  history             AnalysisHistory[]
  snapshots           SectionSnapshot[]
  notificationState   PodcastNotificationState?
  sentimentSnapshots  SentimentSnapshot[]
  entropySnapshots    EntropySnapshot[]
  createdAt           DateTime                  @default(now())
}

model PodcastEpisode {
  id           String   @id @default(cuid())
  trackId      BigInt   @unique
  trackName    String
  description  String
  releaseDate  DateTime
  durationMs   Int
  episodeUrl   String
  trackViewUrl String
  artworkUrl   String
  aiSummary    String?
  fetchedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([releaseDate(sort: Desc)])
}

model PodcastNotificationState {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenTrackId BigInt?
  updatedAt       DateTime @updatedAt
}

model Section {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String            @default("📊")
  color     String            @default("#d4a843")
  positions Position[]
  snapshots SectionSnapshot[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model Position {
  id            String   @id @default(cuid())
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  ticker        String
  companyName   String
  purchasePrice Float?
  quantity      Float?
  currency      String   @default("USD")
  addedAt       DateTime @default(now())
}

model SectionSnapshot {
  id           String   @id @default(cuid())
  userId       String
  sectionId    String
  sectionName  String
  date         String   // "YYYY-MM-DD"
  avgChangePct Float
  pnlEur       Float    @default(0)
  createdAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId, date])
  @@index([userId, date(sort: Desc)])
}

model AnalysisHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticker      String
  companyName String
  score       Float
  signal      String
  sector      String
  pillars     Json
  analyzedAt  DateTime @default(now())

  @@index([userId, analyzedAt(sort: Desc)])
  @@index([ticker])
}

model SentimentSnapshot {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  score     Float
  summary   String
  newsCount Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, ticker, createdAt(sort: Desc)])
}

model EntropySnapshot {
  id         String   @id @default(cuid())
  userId     String
  date       String   // "YYYY-MM-DD"
  avgEntropy Float
  regime     String   // "HIGH" | "ELEVATED" | "NORMAL"
  hotspots   String[]
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
}

model SharedAnalysis {
  id          String   @id @default(cuid())
  ticker      String
  companyName String
  sector      String
  composite   Float
  signal      String
  scores      Json
  quote       Json
  metrics     Json
  isCrypto    Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([createdAt(sort: Desc)])
}
